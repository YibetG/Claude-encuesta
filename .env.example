# ---------------------------------------------------------------
# Copie este archivo como `.env` y ajuste los valores.
# Nunca suba `.env` al repositorio: contiene secretos.
# ---------------------------------------------------------------

# --- Base de datos ---------------------------------------------
# Ruta del archivo SQLite. La carpeta se crea automáticamente.
DATABASE_URL=data/app.db

# --- Aplicación ------------------------------------------------
# URL pública con la que los participantes abren el assessment.
# En producción, use la URL real (https://...).
APP_URL=http://localhost:5173

# Al desplegar con adapter-node, defina también ORIGIN con la misma URL
# para que la protección CSRF de SvelteKit reconozca el origen.
# ORIGIN=https://assessments.midominio.com

# En producción (adapter-node) el tamaño máximo de petición por defecto es 512 KB.
# Para permitir importar archivos Excel/CSV de hasta 2 MB:
# BODY_SIZE_LIMIT=3M

# Detrás de un proxy inverso (Nginx, Caddy, IIS…), indique de dónde leer la IP real
# del visitante. Sin esto, todos comparten la IP del proxy: el bloqueo por intentos
# fallidos afectaría a todos y la auditoría registraría la IP del proxy.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Duración de las sesiones (horas). Se renuevan mientras haya actividad.
ADMIN_SESSION_HOURS=12
PARTICIPANT_SESSION_HOURS=72

# --- IA (Anthropic) --------------------------------------------
# Obtenga la key en https://console.anthropic.com. Solo se usa en el servidor.
# Si se deja vacía, el botón "Analizar con IA" mostrará un aviso.
ANTHROPIC_API_KEY=
# Modelo de Claude. Por defecto Claude Opus 5.5 (el más capaz de la línea Opus).
# Alternativa más económica: claude-sonnet-5-5. Use modelos de la generación 5.
ANTHROPIC_MODEL=claude-opus-5-5
# Tiempo máximo por llamada (ms).
AI_TIMEOUT_MS=180000

# --- Correo (SMTP) ---------------------------------------------
# En local se recomienda Mailpit (https://mailpit.axllent.org):
#   SMTP_HOST=localhost  SMTP_PORT=1025  -> ver correos en http://localhost:8025
# Si SMTP_HOST queda vacío, los correos se imprimen en la consola.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Assessments <no-reply@localhost>
