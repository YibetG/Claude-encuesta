{
	"name": "claude-encuesta",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest --run && playwright test",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file=.env scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"create-admin": "tsx --env-file=.env scripts/create-admin.ts",
		"db:seed": "tsx --env-file=.env scripts/seed.ts",
		"db:backup": "tsx --env-file=.env scripts/backup.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/nodemailer": "^8.0.2",
		"@types/pdfmake": "^0.3.3",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.135.0",
		"@date-fns/tz": "^1.5.0",
		"@fontsource-variable/mulish": "^5.3.0",
		"@fontsource-variable/rubik": "^5.3.0",
		"@node-rs/argon2": "^2.2.2",
		"better-sqlite3": "^13.0.2",
		"date-fns": "^4.4.0",
		"drizzle-orm": "^0.45.2",
		"exceljs": "^4.4.0",
		"fflate": "^0.8.3",
		"nodemailer": "^10.1.7",
		"pdfmake": "^0.3.12",
		"zod": "^4.6.7"
	},
	"overrides": {
		"uuid": "^11.1.1"
	},
	"allowScripts": {
		"better-sqlite3@13.0.3": true,
		"esbuild@0.18.20": true,
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true
	}
}
